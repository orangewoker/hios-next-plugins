{
  "schemaVersion": 1,
  "id": "web-browser",
  "name": "浏览器",
  "version": "0.3.1",
  "description": "节点内真实网页浏览，按需悬浮添加或拖放原图，无自动采集与独立窗口。需配套新版 HIOS Tauri。",
  "author": "HIOS Next",
  "homepage": "https://github.com/orangewoker/hios-next-plugins/tree/main/plugins/web-browser",
  "permissions": [
    "canvas",
    "network"
  ],
  "capabilities": [
    {
      "id": "web.browser",
      "title": "网页浏览与原图采集",
      "description": "节点内真实网页浏览，按需悬浮添加或拖放原图，无自动采集与独立窗口。需配套新版 HIOS Tauri。"
    }
  ],
  "nodes": [
    {
      "id": "web.browser",
      "title": "浏览器",
      "description": "节点内真实网页浏览，按需悬浮添加或拖放原图，无自动采集与独立窗口。需配套新版 HIOS Tauri。",
      "rendererEntry": "runtime/index.html",
      "inputs": [],
      "outputs": [
        {
          "id": "image",
          "title": "当前原图",
          "type": "image"
        }
      ],
      "hidePortLabels": true,
      "defaultSize": {
        "width": 760,
        "height": 620
      },
      "defaultData": {
        "url": "https://www.bing.com/images",
        "tab": "page",
        "zoom": 1
      }
    }
  ]
}
