{
  "schemaVersion": 1,
  "id": "web-browser",
  "name": "浏览器",
  "version": "0.1.0",
  "description": "画布内的轻量网页阅读和原图采集节点，可浏览公开网页并把原图加入画布。",
  "author": "HIOS Next",
  "homepage": "https://github.com/orangewoker/hios-next-plugins/tree/main/plugins/web-browser",
  "permissions": ["canvas", "network"],
  "capabilities": [
    {
      "id": "web.browser",
      "title": "网页浏览与原图采集",
      "description": "读取公开网页、提取原图并输出到画布。"
    }
  ],
  "nodes": [
    {
      "id": "web.browser",
      "title": "浏览器",
      "description": "输入网址浏览公开网页，在原图库中拖动或点击图片加入画布。",
      "rendererEntry": "runtime/index.html",
      "inputs": [],
      "outputs": [
        { "id": "image", "title": "当前原图", "type": "image" }
      ],
      "hidePortLabels": true,
      "defaultSize": { "width": 760, "height": 620 },
      "defaultData": {
        "url": "https://www.bing.com/images",
        "tab": "page",
        "zoom": 1
      }
    }
  ]
}
