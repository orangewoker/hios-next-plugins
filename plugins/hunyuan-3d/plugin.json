{
  "schemaVersion": 1,
  "id": "hunyuan-3d",
  "name": "混元3D",
  "version": "0.2.0",
  "description": "调用腾讯混元生3D API，通过文本、单图或多视图生成、预览和导出3D模型。",
  "author": "HIOS Next",
  "homepage": "https://github.com/orangewoker/hios-next-plugins/tree/main/plugins/hunyuan-3d",
  "permissions": ["network", "canvas"],
  "capabilities": [
    {
      "id": "hunyuan-3d.generate",
      "title": "混元生3D",
      "description": "文本、图片与多视图生成3D模型。",
      "settings": true
    }
  ],
  "nodes": [
    {
      "id": "hunyuan-3d.generate",
      "title": "混元3D生成",
      "description": "连接文字、单图或多视图图片，生成3D模型并输出文件、预览图及结果 JSON。",
      "rendererEntry": "runtime/index.html",
      "permissions": ["network"],
      "inputs": [
        { "id": "text", "title": "文字", "type": "text" },
        { "id": "image", "title": "单图", "type": "image" },
        { "id": "multiview", "title": "多视图图片", "type": "image", "multiple": true }
      ],
      "outputs": [
        { "id": "file", "title": "模型文件", "type": "file" },
        { "id": "preview", "title": "预览图片", "type": "image" },
        { "id": "result", "title": "生成结果 JSON", "type": "json" }
      ],
      "defaultSize": { "width": 480, "height": 460 }
    }
  ],
  "contributes": {
    "apps": [
      {
        "id": "hunyuan-3d",
        "title": "混元3D",
        "description": "生成、预览和导出高质量3D模型",
        "entry": "app/index.html",
        "icon": "assets/icon.svg",
        "category": "creative"
      }
    ]
  }
}
