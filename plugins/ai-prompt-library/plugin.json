{
  "schemaVersion": 1,
  "id": "ai-prompt-library",
  "name": "AI 提示词库",
  "version": "0.3.0",
  "description": "连接自托管 AI Prompt Library，按分类保存图片和提示词，或随机抽取提示词输出到画布。",
  "author": "HIOS Next",
  "homepage": "https://github.com/orangewoker/hios-next-plugins/tree/main/plugins/ai-prompt-library",
  "permissions": [
    "network",
    "canvas"
  ],
  "capabilities": [
    {
      "id": "prompt.random",
      "title": "随机提示词",
      "description": "从 AI Prompt Library 的授权分类中随机抽取提示词。"
    }
  ],
  "nodes": [
    {
      "id": "prompt.random",
      "title": "随机提示词库",
      "description": "将输入的图片或提示词保存到指定分类，也可随机抽取提示词并输出。",
      "rendererEntry": "runtime/index.html",
      "inputs": [
        {
          "id": "image",
          "title": "图片",
          "type": "image"
        },
        {
          "id": "prompt_input",
          "title": "待保存提示词",
          "type": "text"
        }
      ],
      "outputs": [
        {
          "id": "prompt",
          "title": "提示词",
          "type": "text"
        }
      ],
      "defaultSize": {
        "width": 520,
        "height": 1060
      },
      "defaultData": {
        "selectedCategoryIds": [],
        "saveCategoryId": null,
        "lastSavedAssetId": null,
        "count": 1,
        "seed": 0,
        "autoOutput": true,
        "selectedIndex": 0,
        "lastItems": []
      }
    }
  ],
  "rendererEntry": "runtime/index.html"
}
