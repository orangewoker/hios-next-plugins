  "contributes": { "apps": [{ "id": "random-prompt-composer", "title": "随机组合提示词", "description": "七类标签随机组合与 LLM 系统提示词。", "entry": "runtime/index.html", "icon": "assets/icon.svg", "category": "creative" }] },
