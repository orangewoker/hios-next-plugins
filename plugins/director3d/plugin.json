{
  "schemaVersion": 1,
  "id": "director3d",
  "name": "3D 导演台",
  "version": "0.1.2",
  "description": "三维场景、人偶动作、AI 局部编辑与相机运镜预演，导出关键帧和视频。",
  "author": "HIOS Next / Toonflow contributors",
  "homepage": "https://github.com/orangewoker/hios-next-plugins/tree/main/plugins/director3d",
  "permissions": ["filesystem", "canvas", "agent"],
  "contributes": { "apps": [{ "id": "director3d", "title": "3D 导演台", "description": "场景、动作与镜头预演", "entry": "runtime/app.html", "icon": "assets/icon.svg", "category": "design" }] },
  "nodes": [{
    "id": "director3d.studio", "title": "3D 导演台", "description": "连接文字与图片参考，编辑场景并输出 PNG、视频和工程。",
    "rendererEntry": "runtime/index.html",
    "inputs": [{ "id": "reference", "title": "文字 / 图片参考", "type": "any", "multiple": true }],
    "outputs": [{ "id": "image", "title": "关键帧", "type": "image" }, { "id": "video", "title": "预演视频", "type": "video" }, { "id": "file", "title": "导演台工程", "type": "file" }],
    "hidePortLabels": true, "defaultSize": { "width": 1120, "height": 760 }, "defaultData": {}
  }],
  "fileAssociations": [{ "extensions": ["director3d"], "mimeTypes": ["application/x-hios-director3d"], "nodeId": "director3d.studio" }]
}
