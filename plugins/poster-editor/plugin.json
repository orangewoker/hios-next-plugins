{
  "schemaVersion": 1,
  "id": "poster-editor",
  "name": "海报编辑器",
  "version": "0.1.1",
  "description": "轻量级图层海报编辑器，支持多图、文字排版、裁剪和常用画布预设。",
  "author": "HIOS Next",
  "permissions": ["canvas", "filesystem"],
  "capabilities": [
    {
      "id": "poster.edit",
      "title": "海报编辑",
      "description": "在独立插件应用中编辑图片、图层和文字。"
    }
  ],
  "contributes": {
    "apps": [
      {
        "id": "poster-editor",
        "title": "海报编辑器",
        "description": "多图图层与文字排版编辑器",
        "entry": "app/index.html",
        "icon": "assets/icon.svg",
        "category": "design"
      }
    ]
  },
  "nodes": [
    {
      "id": "poster-editor",
      "title": "海报编辑器",
      "description": "打开海报编辑器，将多张图片和文字排版为一张海报。",
      "rendererEntry": "runtime/index.html",
      "inputs": [
        { "id": "images", "title": "图片", "type": "image", "multiple": true }
      ],
      "outputs": [
        { "id": "image", "title": "海报", "type": "image" }
      ],
      "hidePortLabels": true,
      "defaultSize": { "width": 520, "height": 430 },
      "defaultData": { "width": 1080, "height": 1350, "background": "#ffffff" }
    }
  ]
}
