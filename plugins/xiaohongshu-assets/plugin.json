{
  "schemaVersion": 1,
  "id": "xiaohongshu-assets",
  "name": "小红书素材库",
  "version": "0.3.1",
  "description": "扫码登录小红书，在可调整大小的画布悬浮窗口中浏览、采集并加入图片素材。",
  "author": "HIOS Next",
  "homepage": "https://github.com/orangewoker/hios-next-plugins/tree/main/plugins/xiaohongshu-assets",
  "permissions": ["network", "filesystem", "canvas", "agent"],
  "capabilities": [{ "id": "xiaohongshu.assets", "title": "小红书素材库", "description": "登录、浏览和采集小红书图片素材。", "settings": true }],
  "nodes": [{
    "id": "xiaohongshu.browser",
    "title": "小红书素材库",
    "description": "独立浏览小红书，右键图片解析高清地址并从 image 端口输出。",
    "rendererEntry": "runtime/index.html",
    "inputs": [{ "id": "query", "title": "搜索词", "type": "text" }],
    "outputs": [{ "id": "image", "title": "采集原图", "type": "image" }],
    "defaultSize": { "width": 920, "height": 680 },
    "defaultData": { "query": "" }
  }]
}
